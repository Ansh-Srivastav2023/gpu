module gpu_interface(
    input clk,
    input rst,

    //CPU side
    input start,
    output reg busy,
    output reg done

);

    wire kernel_done;
    reg kernel_start;

    gpu_top gpu_top(.clk(clk), .rst(rst), 
                    .kernel_done(kernel_done), 
                    .kernel_start(kernel_start));

    parameter IDLE      = 2'b00;
    parameter LAUNCH    = 2'b01;
    parameter RUN       = 2'b10;
    parameter FINISH    = 2'b11;

    reg [1:0] state = 2'b00;

    always @(posedge clk or negedge rst) begin
        if(~rst) begin
            state <= IDLE;
            busy  <= 0;
            done  <= 0;
            kernel_start <= 0;
        end
        else begin
            busy  <= 0;
            done  <= 0;
            kernel_start <= 0;
            case(state)
                IDLE: begin
                    kernel_start <= 1'b0;
                    busy         <= 1'b0;
                    if(start) begin
                        busy    <= 0;
                        kernel_start <= 1'b1;
                        state <= LAUNCH;
                    end
                end
                
                LAUNCH: begin
                    busy  <= 1'b1;
                    state <= RUN;
                end
                
                RUN: begin
                    busy  <= 1'b1;
                    if(kernel_done) begin
                        state <= FINISH;
                    end
                end

                FINISH: begin
                    busy <= 1'b0;
                    done <= 1'b1;
                    state <= IDLE;
                end

                default: begin
                    state <= IDLE;
                end
            endcase
        end
        
    end
endmodule